WR EQU P0.7
FIND EQU P3.7 

MAIN:
  ACALL MEU_ADC
  JMP MAIN

  MOV P1,#128
  CLR WR
  SETB WR

;ALTERA O DAC ATE ACHAR O VALOR DA 
;ENTRADA ANALOGICA
;ENTAO P1 TERA O VALOR DIGITAL
;DA ANALOGICA
;DESTROI ACC E PSW E WR

MEU_ADC:
   PUSH P1
   MOV P1,#0
   CLR WR

MEU_ADC_CONTINUA:

   JNB FIND, MEU_ADC_FIM
   INC P1
   JMP MEU_ADC_CONTINUA
 MEU_ADC_FIM:
   MOV A,P1
   SETB WR
   POP P1
   RET
