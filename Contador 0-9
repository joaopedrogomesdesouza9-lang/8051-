CONTADOR_250US    EQU 40H ; 40x250us=10ms
CONTADOR_10MS     EQU 41H ; 100x10us
CONTADOR_DISPLAY  EQU 42H 
VALOR_TH0 EQU 06 ; 256 - 250 = 6

ORG 0000H
LJMP MAIN

ORG 000BH         
LJMP Timer0

ORG 0030H
MAIN:
    MOV CONTADOR_250US, #40   
    MOV CONTADOR_10MS, #100    
    MOV CONTADOR_DISPLAY, #0   
    
    ; Configurar Timer 0
    MOV TMOD, #02H
    MOV TH0, #VALOR_TH0       
    MOV TL0, #VALOR_TH0       
    
    ; Exibe 0
    MOV A, CONTADOR_DISPLAY
    LCALL WR_7SEG
    
    SETB ET0                  
    SETB EA                    
    SETB TR0
    
LOOP:
    SJMP LOOP                  


Timer0:
    DJNZ CONTADOR_250US, Exit
    MOV CONTADOR_250US, #40          
    
    DJNZ CONTADOR_10MS, Exit
    MOV CONTADOR_10MS, #100 

    INC CONTADOR_DISPLAY            
    MOV A, CONTADOR_DISPLAY          
    CJNE A, #10, ATUALIZA_DISPLAY 
    MOV CONTADOR_DISPLAY, #0         
    MOV A, #0                        
    
ATUALIZA_DISPLAY:
    LCALL WR_7SEG                    
    
Exit:
    RETI                            


WR_7SEG:
    PUSH    ACC
    MOV     DPTR, #TAB_7SEG
    MOVC    A, @A+DPTR       
    MOV     P1, A            
    POP     ACC
    RET

TAB_7SEG:
    DB 11000000B  ; 0 
    DB 11111001B  ; 1 
    DB 10100100B  ; 2 
    DB 10110000B  ; 3 
    DB 10011001B  ; 4 
    DB 10010010B  ; 5 
    DB 10000010B  ; 6 
    DB 11111000B  ; 7 
    DB 10000000B  ; 8 
    DB 10010000B  ; 9 

END
