; ===================================================================
;  CRONÔMETRO CORRIGIDO - LÓGICA INVERTIDA (ACTIVE LOW)
;  PARA HARDWARE: COMMON ANODE + PNP TRANSISTORS
; ===================================================================

CONTADOR_INT     EQU 30H  
DIG_DEZ_MS       EQU 31H  
DIG_CEN_MS       EQU 32H  
DIG_SEC          EQU 33H  

VALOR_TH0        EQU 06   

ORG 0000H
    LJMP MAIN

ORG 000BH
    LJMP TIMER0_ISR

ORG 0030H
MAIN:
    ; --- INICIALIZAÇÃO ---
    MOV CONTADOR_INT, #40
    MOV DIG_DEZ_MS, #0
    MOV DIG_CEN_MS, #0
    MOV DIG_SEC, #0

    ; Configura Timer 0
    MOV TMOD, #02H      
    MOV TH0, #VALOR_TH0
    MOV TL0, #VALOR_TH0
    
    ; --- CORREÇÃO PRINCIPAL AQUI ---
    ; Começa com todos os bits da P3 em 1.
    ; Em lógica PNP, 1 significa DESLIGADO.
    MOV P3, #0FFH 

    SETB ET0
    SETB EA
    SETB TR0 

; ===================================================================
; LOOP PRINCIPAL COM LÓGICA INVERTIDA
; "CLR" agora liga o display (Terra virtual)
; "SETB" ou mov #0FFh desliga
; ===================================================================
LOOP:
     ; -------------------------------------------------------
    ; 3. EXIBIR DEZENAS MS (Direita - P3.2)
    ; -------------------------------------------------------
    MOV P3, #0FFH      ; Desliga tudo
    MOV A, DIG_DEZ_MS   
    LCALL WR_7SEG
    CLR P3.3            ; <--- CLR LIGA O PINO 3.2
   
    ; -------------------------------------------------------
    ; 2. EXIBIR CENTENAS MS (Meio - P3.1)
    ; -------------------------------------------------------
    MOV P3, #0FFH       ; Desliga tudo
    MOV A, DIG_CEN_MS   
    LCALL WR_7SEG
    CLR P3.2            ; <--- CLR LIGA O PINO 3.1
    
    ; -------------------------------------------------------
    ; 1. EXIBIR SEGUNDOS (Esquerda - P3.3)
    ; -------------------------------------------------------
    MOV P3, #0FFH       ; Desliga todos os displays (Reset)
    MOV A, DIG_SEC      
    LCALL WR_7SEG       
    CLR P3.1            ; <--- CLR LIGA O PINO 3.3 (Sinal 0V)
       

    

    

    SJMP LOOP

; ===================================================================
; INTERRUPÇÃO (Igual à anterior)
; ===================================================================
TIMER0_ISR:
    PUSH PSW
    PUSH ACC

    DJNZ CONTADOR_INT, SAIDA_ISR 
    MOV CONTADOR_INT, #40        
    
    ; Atualiza Dezena MS (Display Direita)
    INC DIG_DEZ_MS
    MOV A, DIG_DEZ_MS
    CJNE A, #10, SAIDA_ISR       
    MOV DIG_DEZ_MS, #0           
    
    ; Atualiza Centena MS (Display Meio)
    INC DIG_CEN_MS
    MOV A, DIG_CEN_MS
    CJNE A, #10, SAIDA_ISR
    MOV DIG_CEN_MS, #0
    
    ; Atualiza Segundos (Display Esquerda)
    INC DIG_SEC
    MOV A, DIG_SEC
    CJNE A, #10, SAIDA_ISR
    MOV DIG_SEC, #0              

SAIDA_ISR:
    POP ACC
    POP PSW
    RETI

; ===================================================================
; SUBROTINAS
; ===================================================================
WR_7SEG:
    MOV DPTR, #TAB_7SEG
    MOVC A, @A+DPTR
    MOV P1, A
    RET

DELAY_MUX:
    ; Ajuste este valor conforme a velocidade do seu PC
         
    MOV R7, #100      
DL2:DJNZ R7, DL2
    
    RET

TAB_7SEG:
    DB 01000000B  ; 0 
    DB 01111001B  ; 1 
    DB 00100100B  ; 2 
    DB 00110000B  ; 3 
    DB 00011001B  ; 4 
    DB 00010010B  ; 5 
    DB 00000010B  ; 6 
    DB 01111000B  ; 7 
    DB 00000000B  ; 8 
    DB 00010000B  ; 9 

END
