ORG 0000h
MOV DPTR, #Vetor
MOV R0, #30h
MOV R1, #40h
MOV B, #10

COLETA:
CLR A
MOVC A, @A+DPTR ;lê os dados da ROM
MOV @R0, A
INC R0
INC DPTR
DJNZ B, COLETA

MOV R0, #30h
MOV R1, #40h
MOV B, #10

Transferido:
MOV A, @R0
MOV @R1, A
INC R0
INC R1
DJNZ B, Transferido

FIM: 
     SJMP FIM

ORG 0100h
Vetor: DB 01h, 02h, 03h, 04h, 05h, 06h, 07h, 08h, 09h, 0Ah

END
