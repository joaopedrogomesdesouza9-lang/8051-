; LCD 16x2
    ; P1.7-P1.4 = DB7-DB4, P1.3 = RS, P1.2 = E
    ; 8051 @ 12MHz (1 ciclo = 1µs)
    ; Timer 0 Modo 2 

RS       EQU P1.3
E        EQU P1.2
CONTADOR EQU 30H     

ORG 0000H
    LJMP INICIO

ORG 000BH                  
    LJMP TIMER0

ORG 0031H
INICIO:

    ; Configura Timer 0 Modo 2 
    MOV TMOD, #02H          
    MOV TH0, #156           ; 256-156 =100µs 
    MOV TL0, #156
    SETB EA                 
    SETB ET0                

    LCALL CONFIGURA_LCD
    
    ; Linha 1 - "JOAO PEDRO"
    MOV A, #83H
    LCALL ENVIA_COMANDO
    
    MOV A, #'J'
    LCALL ESCREVE_LETRA
    MOV A, #'O'
    LCALL ESCREVE_LETRA
    MOV A, #'A'
    LCALL ESCREVE_LETRA
    MOV A, #'O'
    LCALL ESCREVE_LETRA
    MOV A, #' '
    LCALL ESCREVE_LETRA
    MOV A, #'P'
    LCALL ESCREVE_LETRA
    MOV A, #'E'
    LCALL ESCREVE_LETRA
    MOV A, #'D'
    LCALL ESCREVE_LETRA
    MOV A, #'R'
    LCALL ESCREVE_LETRA
    MOV A, #'O'
    LCALL ESCREVE_LETRA
    
    ; Linha 2 - "GOMES DE SOUZA"
    MOV A, #0C1H
    LCALL ENVIA_COMANDO
    
    MOV A, #'G'
    LCALL ESCREVE_LETRA
    MOV A, #'O'
    LCALL ESCREVE_LETRA
    MOV A, #'M'
    LCALL ESCREVE_LETRA
    MOV A, #'E'
    LCALL ESCREVE_LETRA
    MOV A, #'S'
    LCALL ESCREVE_LETRA
    MOV A, #' '
    LCALL ESCREVE_LETRA
    MOV A, #'D'
    LCALL ESCREVE_LETRA
    MOV A, #'E'
    LCALL ESCREVE_LETRA
    MOV A, #' '
    LCALL ESCREVE_LETRA
    MOV A, #'S'
    LCALL ESCREVE_LETRA
    MOV A, #'O'
    LCALL ESCREVE_LETRA
    MOV A, #'U'
    LCALL ESCREVE_LETRA
    MOV A, #'Z'
    LCALL ESCREVE_LETRA
    MOV A, #'A'
    LCALL ESCREVE_LETRA
    
    SJMP $


; ========== ROTINAS DO LCD ==========

CONFIGURA_LCD:
    LCALL ESPERA_16MS      

    ; RS = 0, R/W = 0
    ; DB7  DB6  DB5  DB4  DB3  DB2  DB1  DB0
    ;  0    0    1    DL    x    x    x    x  
    
    MOV A, #30H             
    LCALL ENVIA_NIBBLE
    LCALL ESPERA_5MS      
    
    MOV A, #30H             
    LCALL ENVIA_NIBBLE
    LCALL ESPERA_100US      
    
    MOV A, #30H             
    LCALL ENVIA_NIBBLE

    MOV A, #20H           
    LCALL ENVIA_NIBBLE
    LCALL ESPERA_100US

    
    ; Agora em modo 4 bits 
    
    ; RS = 0, R/W = 0
    ; DB7  DB6  DB5  DB4  DB3  DB2  DB1  DB0
    ;  0    0    1    DL   N    F    x    x
 
    MOV A, #28H             ; 4 bits, 2 linhas, fonte 5x8
    LCALL ENVIA_COMANDO
    

    ; RS = 0, R/W = 0
    ; DB7  DB6  DB5  DB4  DB3  DB2  DB1  DB0
    ;  0    0    0    0    1    D    C    B
    
    MOV A, #0CH             ; Display ligado, cursor desligado 
    LCALL ENVIA_COMANDO
    
    MOV A, #01H             ; Limpa LCD
    LCALL ENVIA_COMANDO
    
    
    ; RS = 0, R/W = 0
    ; DB7  DB6  DB5  DB4  DB3  DB2  DB1  DB0
    ;  0    0    0    0    0    1   I/D   S
    
    MOV A, #06H             ; Cursor incrementa
    LCALL ENVIA_COMANDO
    RET


ENVIA_NIBBLE:
    CLR RS
    ANL A, #0F0H
    ANL P1, #0FH
    ORL P1, A
    LCALL PULSO_ENABLE
    RET

ENVIA_COMANDO:
    CLR RS
    SJMP ENVIA_DADOS_LCD


ESCREVE_LETRA:
    SETB RS


; Envia os 8 bits em duas partes de 4 bits
ENVIA_DADOS_LCD:
    PUSH ACC
    ANL A, #0F0H
    ANL P1, #0FH
    ORL P1, A
    MOV C, RS
    MOV P1.3, C
    LCALL PULSO_ENABLE
    
    POP ACC
    SWAP A
    ANL A, #0F0H
    ANL P1, #0FH
    ORL P1, A
    MOV C, RS
    MOV P1.3, C
    LCALL PULSO_ENABLE
    RET


PULSO_ENABLE:
    SETB E
    NOP
    CLR E
    NOP
    RET


; ========== ROTINAS DE TEMPO  ==========

TIMER0:
    DJNZ CONTADOR, FIM
    CLR TR0                 ; Para timer quando contador = 0
FIM:
    RETI


ESPERA_TIMER:
    SETB TR0              
ESPERA_LOOP:
    JB TR0, ESPERA_LOOP     
    RET


ESPERA_100US:
    MOV CONTADOR, #1        ; 1 x 100µs
    LCALL ESPERA_TIMER
    RET

ESPERA_1MS:
    MOV CONTADOR, #10       ; 10 x 100µs = 1ms
    LCALL ESPERA_TIMER
    RET

ESPERA_5MS:
    MOV CONTADOR, #50       ; 50 x 100µs = 5ms
    LCALL ESPERA_TIMER
    RET

ESPERA_16MS:
    MOV CONTADOR, #160      ; 160 x 100µs = 16ms
    LCALL ESPERA_TIMER
    RET

END
